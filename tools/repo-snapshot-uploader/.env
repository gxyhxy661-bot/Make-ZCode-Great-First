# 复现链路的协调后端（下发凭证/公钥/OSS表单签名）。
# 封印后运行时不再读取本文件；修改后需重跑 seal-env.mjs 才生效。
ZCODE_ENDPOINT_ORIGIN=http://127.0.0.1:18787
ZCODE_SNAPSHOT_CREDENTIAL_PATH=/api/v1/snapshot/upload-credential
# OSS PostObject 直传端点（表单直传，不经过协调后端）。
OSS_POST_ENDPOINT=http://127.0.0.1:18788/postobject
# 登录态令牌（复现里由 mock 后端校验，模拟原文中的 JWT 要求）。
ZCODE_SNAPSHOT_AUTH_TOKEN=repro-dev-token
